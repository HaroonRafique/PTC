TITLE, "PyPTC admission iteration 0003";
CALL, FILE="../snapshot_inputs/ISIS.injected_beam";
CALL, FILE="../snapshot_inputs/ISIS.elements";
CALL, FILE="../snapshot_inputs/ISIS.strength";
CALL, FILE="../snapshot_inputs/2023.strength";
CALL, FILE="../snapshot_inputs/ISIS.sequence";
a1=0; b1=0; kqtd=0; kqtf=0;
USE, SEQUENCE=synchrotron;
VALUE, a1; VALUE, b1; VALUE, kqtd; VALUE, kqtf;
VALUE, kqtd_0;
VALUE, kqtd_1;
VALUE, kqtd_2;
VALUE, kqtd_3;
VALUE, kqtd_4;
VALUE, kqtd_5;
VALUE, kqtd_6;
VALUE, kqtd_7;
VALUE, kqtd_8;
VALUE, kqtd_9;
VALUE, kqtf_0;
VALUE, kqtf_1;
VALUE, kqtf_2;
VALUE, kqtf_3;
VALUE, kqtf_4;
VALUE, kqtf_5;
VALUE, kqtf_6;
VALUE, kqtf_7;
VALUE, kqtf_8;
VALUE, kqtf_9;
SELECT, FLAG=TWISS, CLEAR;
SELECT, FLAG=TWISS, COLUMN=name, s, x, px, y, py, betx, bety, alfx, alfy;
TWISS, SAVE, FILE="reference_twiss.tfs";
propagation_method=2; order_of_integrator=6; integration_steps_per_element=5;
ptc_create_universe;
ptc_create_layout,time=true,model=propagation_method,exact=true,method=order_of_integrator,nst=integration_steps_per_element;
ptc_script, file="PTC_Scripts/resplit.ptc";
ptc_script, file="PTC_Scripts/print_flat_file.ptc";
ptc_end;
